#: functions.php
msgid "Header — Desktop"
msgstr "هدر — دسکتاپ"

#: functions.php
msgid "Header — Mobile (optional)"
msgstr "هدر — موبایل (اختیاری)"

#: functions.php
msgid "Default post image"
msgstr "تصویر پیش‌فرض مطالب"

#: functions.php
msgid "Used for posts without a featured image. If no image is selected, the theme default will be displayed."
msgstr "برای مطالب بدون تصویر شاخص استفاده می‌شود. اگر تصویری انتخاب نکنید، طرح پیش‌فرض قالب نمایش داده می‌شود."

#: functions.php
msgid "Sticky header mode"
msgstr "حالت استیکی هدر"

#: functions.php
msgid "Choose the screen sizes where the header remains fixed while scrolling."
msgstr "مشخص کنید هدر در کدام نمایش هنگام اسکرول ثابت بماند."

#: functions.php
msgid "Off"
msgstr "خاموش"

#: functions.php
msgid "Mobile only"
msgstr "فقط موبایل"

#: functions.php
msgid "Desktop only"
msgstr "فقط دسکتاپ"

#: functions.php
msgid "Mobile and desktop"
msgstr "موبایل و دسکتاپ"

#: acf-json/group_home_blog.json
msgid "Blog homepage — Sections"
msgstr "صفحه اصلی بلاگ — بخش‌ها"

#: acf-json/group_home_blog.json
msgid "Homepage sections"
msgstr "بخش‌های صفحه اصلی"

#: acf-json/group_home_blog.json
msgid "Choose a layout, set its content, and drag sections to reorder them. Post cards are populated automatically from the selected categories."
msgstr "نوع چیدمان و محتوای هر بخش را انتخاب کنید و بخش‌ها را با کشیدن جابه‌جا کنید. کارت‌های مطالب به‌صورت خودکار از دسته‌های انتخاب‌شده نمایش داده می‌شوند."

#: acf-json/group_home_blog.json
msgid "Add section"
msgstr "افزودن بخش"

#: acf-json/group_home_blog.json
msgid "1) Image-overlay post cards (two-row grid)"
msgstr "۱) کارت‌های تصویری با متن روی عکس (چیدمان دو ردیفی)"

#: acf-json/group_home_blog.json
msgid "Category"
msgstr "دسته"

#: acf-json/group_home_blog.json
msgid "Empty = latest posts from all categories."
msgstr "خالی = جدیدترین پست‌ها از همهٔ دسته‌ها."

#: acf-json/group_home_blog.json
msgid "Post count"
msgstr "تعداد پست"

#: acf-json/group_home_blog.json
msgid "2) Vertical post cards (four-column grid)"
msgstr "۲) کارت‌های عمودی مطالب (چیدمان چهار ستونی)"

#: acf-json/group_home_blog.json
msgid "Heading (optional)"
msgstr "عنوان (اختیاری)"

#: acf-json/group_home_blog.json
msgid "Empty = category name."
msgstr "خالی = نام دسته."

#: acf-json/group_home_blog.json
msgid "“View more” link (optional)"
msgstr "لینک «مشاهده بیشتر» (اختیاری)"

#: acf-json/group_home_blog.json
msgid "Empty = the category archive page."
msgstr "خالی = صفحهٔ آرشیو همان دسته."

#: acf-json/group_home_blog.json
msgid "3) Full-width image banner"
msgstr "۳) بنر تصویری تمام‌عرض"

#: acf-json/group_home_blog.json
msgid "Banner image"
msgstr "تصویر بنر"

#: acf-json/group_home_blog.json
msgid "Link (optional)"
msgstr "لینک (اختیاری)"

#: acf-json/group_home_blog.json
msgid "4) Category cards (horizontal slider)"
msgstr "۴) کارت‌های دسته‌بندی (اسلایدر افقی)"

#: acf-json/group_home_blog.json
msgid "Categories"
msgstr "دسته‌ها"

#: acf-json/group_home_blog.json
msgid "Select the categories to display. Each card uses the latest post in that category for its image."
msgstr "دسته‌هایی که می‌خواهی نمایش داده شوند را انتخاب کن. تصویرِ هر کارت از آخرین پستِ همان دسته گرفته می‌شود."

#: acf-json/group_home_blog.json
msgid "5) Horizontal post cards (two-column grid)"
msgstr "۵) کارت‌های افقی مطالب (چیدمان دو ستونی)"

#: acf-json/group_home_blog.json
msgid "6) Post cards with a latest-posts sidebar"
msgstr "۶) کارت‌های مطالب همراه ستون آخرین مطالب"

#: acf-json/group_home_blog.json
msgid "Main posts category"
msgstr "دسته مطالب اصلی"

#: acf-json/group_home_blog.json
msgid "Main posts count"
msgstr "تعداد مطالب اصلی"

#: acf-json/group_home_blog.json
msgid "Main posts heading (optional)"
msgstr "عنوان بخش مطالب اصلی (اختیاری)"

#: acf-json/group_home_blog.json
msgid "Empty = category name or the default section heading."
msgstr "خالی = نام دسته یا عنوان پیش‌فرض بخش."

#: acf-json/group_home_blog.json
msgid "Main posts “View more” link (optional)"
msgstr "لینک «مشاهده بیشتر» مطالب اصلی (اختیاری)"

#: acf-json/group_home_blog.json
msgid "Latest posts category (optional)"
msgstr "دستهٔ آخرین مطالب (اختیاری)"

#: acf-json/group_home_blog.json
msgid "Latest posts count"
msgstr "تعداد آخرین مطالب"

#: acf-json/group_home_blog.json
msgid "Latest posts heading (optional)"
msgstr "عنوان آخرین مطالب (اختیاری)"

#: acf-json/group_home_blog.json
msgid "Reorderable homepage sections; each section displays posts from one blog category."
msgstr "بخش‌های قابل‌جابه‌جاییِ صفحهٔ اصلی؛ هر بخش پست‌های یک دستهٔ بلاگ را نمایش می‌دهد."

#: inc/acf-field-groups.php
msgid "Term icon"
msgstr "آیکون ترم"

#: inc/acf-field-groups.php
msgid "Icon"
msgstr "آیکون"

#: inc/acf-field-groups.php
msgid "Choose the icon displayed for this term."
msgstr "آیکون نمایش‌داده‌شده برای این ترم را انتخاب کنید."

#: inc/acf-field-groups.php
msgid "Iconly icon assigned to a WordPress term."
msgstr "آیکون Iconly اختصاص‌یافته به یک ترم وردپرس."

#: inc/site-settings.php
msgid "Site settings"
msgstr "تنظیمات سایت"

#: inc/site-settings.php
msgid "Header and footer settings"
msgstr "تنظیمات هدر و فوتر"

#: inc/site-settings.php
msgid "Header and footer"
msgstr "هدر و فوتر"

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Site settings — Header and footer"
msgstr "تنظیمات سایت — هدر و فوتر"

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Header"
msgstr "هدر"

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Main site logo"
msgstr "لوگوی اصلی سایت"

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Displayed in the desktop and mobile header."
msgstr "در هدر دسکتاپ و موبایل نمایش داده می‌شود."

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Desktop menu"
msgstr "فهرست دسکتاپ"

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Choose the main desktop menu. Its WPML translation is used automatically when available."
msgstr "فهرست اصلی هدر دسکتاپ را انتخاب کنید. ترجمهٔ WPML آن در صورت وجود به‌صورت خودکار استفاده می‌شود."

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Select a menu"
msgstr "یک فهرست انتخاب کنید"

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Mobile menu"
msgstr "فهرست موبایل"

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Optional. The desktop menu is used when this field is empty."
msgstr "اختیاری است. اگر این فیلد خالی باشد، فهرست دسکتاپ نمایش داده می‌شود."

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Header phone number"
msgstr "شماره تماس هدر"

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "The number shown to visitors."
msgstr "شماره‌ای که به کاربر نمایش داده می‌شود."

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Header phone link"
msgstr "لینک تماس هدر"

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Use the international format for the tel link, for example +982143997."
msgstr "برای لینک تماس از فرمت بین‌المللی استفاده کنید؛ مثلاً +982143997."

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Footer"
msgstr "فوتر"

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Footer logo"
msgstr "لوگوی فوتر"

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Optional. The main site logo is used when this field is empty."
msgstr "اختیاری است. اگر این فیلد خالی باشد، لوگوی اصلی سایت نمایش داده می‌شود."

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Footer text"
msgstr "متن فوتر"

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "A short text displayed below the footer logo."
msgstr "متن کوتاهی که زیر لوگوی فوتر نمایش داده می‌شود."

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Footer phone number"
msgstr "شماره تماس فوتر"

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Footer phone link"
msgstr "لینک تماس فوتر"

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Footer email"
msgstr "ایمیل فوتر"

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Leave empty to use the WordPress administration email."
msgstr "برای استفاده از ایمیل مدیریت وردپرس، این فیلد را خالی بگذارید."

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Footer column 1 menu"
msgstr "فهرست ستون اول فوتر"

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Choose the main menu for the first footer column. Its WPML translation is used automatically when available."
msgstr "فهرست اصلی ستون اول فوتر را انتخاب کنید. ترجمهٔ WPML آن در صورت وجود به‌صورت خودکار استفاده می‌شود."

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Footer column 2 menu"
msgstr "فهرست ستون دوم فوتر"

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Choose the main menu for the second footer column. Its WPML translation is used automatically when available."
msgstr "فهرست اصلی ستون دوم فوتر را انتخاب کنید. ترجمهٔ WPML آن در صورت وجود به‌صورت خودکار استفاده می‌شود."

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Footer copyright sentence"
msgstr "جمله حقوق فوتر"

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Displayed after the year and site name."
msgstr "بعد از سال و نام سایت نمایش داده می‌شود."

#: Doc/acf-import/group_cn_site_header_footer.json
msgid "Site-wide header and footer settings stored in the standard ACF options record."
msgstr "تنظیمات سراسری هدر و فوتر که در رکورد استاندارد Options افزونهٔ ACF ذخیره می‌شوند."

#: inc/acf-field-groups.php
msgid "Enabled"
msgstr "فعال"

#: inc/acf-field-groups.php
msgid "Disabled"
msgstr "غیرفعال"
