 your reports. The {{strong}}Refunded{{\/strong}} status can not be excluded.":["\u062a\u064f\u0633\u062a\u0628\u0639\u062f \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u062a\u0636\u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u062d\u0627\u0644\u0627\u062a \u0645\u0646 \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0627\u062a \u0641\u064a \u062a\u0642\u0627\u0631\u064a\u0631\u0643. \u064a\u062a\u0639\u0630\u0631 \u0627\u0633\u062a\u0628\u0639\u0627\u062f \u062d\u0627\u0644\u0629 {{strong}}\u062a\u0645 \u0627\u0644\u0627\u0633\u062a\u0631\u062f\u0627\u062f{{\/strong}}."],"Custom Statuses":["\u0627\u0644\u062d\u0627\u0644\u0627\u062a \u0627\u0644\u0645\u062e\u0635\u0635\u0629"],"Excluded statuses:":["\u0627\u0644\u062d\u0627\u0644\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u0628\u0639\u062f\u0629:"],"Exclude the %s status from reports":["\u0627\u0633\u062a\u0628\u0639\u0627\u062f \u062d\u0627\u0644\u0629 %s \u0645\u0646 \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631"],"MM\/DD\/YYYY":["MM\/DD\/YYYY"],"Status:":["\u0627\u0644\u062d\u0627\u0644\u0629:"],"Cancel":["\u0625\u0644\u063a\u0627\u0621"]}},"comment":{"reference":"assets\/client\/admin\/chunks\/analytics-settings.js"}}